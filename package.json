{
	"name": "@juanibiapina/pi-gob",
	"version": "0.5.1",
	"description": "Pi extension for managing gob background jobs",
	"type": "module",
	"main": "dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"check": "biome check --write --error-on-warnings . && tsc --noEmit",
		"prepublishOnly": "npm run clean && npm run build && npm run check"
	},
	"files": [
		"dist/**/*",
		"README.md"
	],
	"keywords": [
		"pi",
		"pi-package",
		"extension",
		"gob",
		"background-jobs"
	],
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"author": "Juan Ibiapina",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/juanibiapina/pi-gob"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"peerDependencies": {
		"@mariozechner/pi-coding-agent": "*",
		"@mariozechner/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.9",
		"@mariozechner/pi-coding-agent": "^0.64.0",
		"@types/node": "^25.5.0",
		"typescript": "^6.0.2"
	}
}
